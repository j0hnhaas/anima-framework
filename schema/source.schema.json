{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/j0hnhaas/anima-framework/schema/source.schema.json",
  "title": "ANIMA source file (front matter)",
  "description": "Metadata of one source and its requirements, mapped onto the triad. Allowed values mirror docs/vocabulary.md and must be kept in sync with it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "short_title", "issuer", "pillar", "jurisdiction", "bindingness", "url", "checked", "checked_by", "status", "requirements"],
  "properties": {
    "id": { "type": "string", "pattern": "^SRC-[A-Z]+-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "short_title": { "type": "string", "minLength": 1 },
    "issuer": { "type": "string", "minLength": 1 },
    "pillar": { "enum": ["law", "guidance", "professional"] },
    "jurisdiction": { "type": "string", "pattern": "^(global|europe|eu|[a-z]{2})$" },
    "bindingness": { "enum": ["binding", "official", "recommended", "professional"] },
    "reference": { "type": "string" },
    "date": { "type": "string", "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$" },
    "version": { "type": "string" },
    "url": { "type": "string", "pattern": "^https?://" },
    "license": { "type": "string" },
    "bibtex_key": { "type": "string" },
    "checked": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "checked_by": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "status": { "enum": ["draft", "reviewed"] },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement", "reference", "edge", "flow", "configuration", "addressee", "topic", "spectrum"],
      "properties": {
        "id": { "type": "string", "pattern": "^ANIMA-(PROH|TRANS|CONS|DATA|SAFE|CRIS|QUAL|EQUI|OVERS|PROF|LIT|ACCT)-[0-9]{3}$" },
        "requirement": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 },
        "edge": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["C-P", "C-AI", "P-AI", "F-AI"] }
        },
        "flow": {
          "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
          "items": { "enum": ["information", "influence", "relationship", "responsibility"] }
        },
        "configuration": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": [1, 2, 3, 4, 5, 6] }
        },
        "addressee": { "enum": ["practitioner", "provider", "institution", "authority", "client"] },
        "topic": { "enum": ["PROH", "TRANS", "CONS", "DATA", "SAFE", "CRIS", "QUAL", "EQUI", "OVERS", "PROF", "LIT", "ACCT"] },
        "spectrum": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["wellbeing", "prevention", "diagnostics-treatment"] }
        },
        "note": { "type": "string" }
      }
    }
  }
}
